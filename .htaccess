RewriteEngine On

# LiteSpeed Web Server Automated reCAPTCHA Bypass:
# Prevents Hostinger/LiteSpeed Anti-DDoS engine from intercepting visitors or form submissions with a CAPTCHA challenge
<IfModule LiteSpeed>
    RewriteRule .* - [E=nrc:1,E=nobreak:1]
</IfModule>
RewriteRule ^api/ - [E=nrc:1]

# 301 Permanent Redirects for Completed Event Pages (Protospark & Tech Fest) to Gallery
RewriteRule ^protospark.*$ /gallery [R=301,L]
RewriteRule ^techfest.*$ /gallery [R=301,L]
RewriteRule ^(?:protospark|techfestregistration).*\.html$ /gallery [R=301,L]

# 1. External Redirect: Redirect direct requests for page.html to /page
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html\s [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Internal Rewrite: Route /page to /page.html internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*?)/?$ $1.html [L]
