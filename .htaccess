RewriteEngine On
DirectoryIndex index.php index.html index.htm

# LiteSpeed Web Server Automated reCAPTCHA Bypass:
# Prevents Hostinger/LiteSpeed Anti-DDoS engine from intercepting visitors or form submissions with a CAPTCHA challenge
<IfModule LiteSpeed>
    RewriteRule .* - [E=nrc:1,E=nobreak:1]
</IfModule>
RewriteRule ^api/ - [E=nrc:1]

# 2026 Flagship Event Landing Pages & Registration Status Portal
RewriteRule ^events/?$ events.html [L]
RewriteRule ^(?:events/)?kids-maker-fair-2026/?$ kids-maker-fair-2026.html [L]
RewriteRule ^(?:events/)?protospark-forge-2026/?$ protospark-forge-2026.html [L]
RewriteRule ^(?:events/)?shipwreck-island-2026/?$ shipwreck-island-2026.html [L]
RewriteRule ^(?:events/)?registration-status/?$ registration-status.html [L]

# 301 Permanent Redirects for Completed Event Pages (Protospark & Tech Fest) to Gallery
RewriteCond %{REQUEST_URI} !protospark-forge-2026 [NC]
RewriteRule ^protospark.*$ /gallery [R=301,L]
RewriteRule ^techfest.*$ /gallery [R=301,L]
RewriteCond %{REQUEST_URI} !protospark-forge-2026 [NC]
RewriteRule ^(?:protospark|techfestregistration).*\.html$ /gallery [R=301,L]

# 1. External Redirect: Redirect direct requests for page.html to /page
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html\s [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Internal Rewrite: Route /page to /page.html internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*?)/?$ $1.html [L]
