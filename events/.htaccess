DirectoryIndex index.php index.html index.htm
Options -Indexes

RewriteEngine On

# Allow direct requests to index
RewriteRule ^/?$ index.html [L]

# Internal rewrites for 2026 event subpages inside /events/
RewriteRule ^kids-maker-fair-2026/?$ kids-maker-fair-2026.html [L]
RewriteRule ^protospark-forge-2026/?$ protospark-forge-2026.html [L]
RewriteRule ^shipwreck-island-2026/?$ shipwreck-island-2026.html [L]
RewriteRule ^registration-status/?$ registration-status.html [L]
